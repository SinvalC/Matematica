    <svg id="mapa2" width="1200" height="905" viewBox="0 0 1200 905" xmlns="http://www.w3.org/2000/svg">
      <rect width="1200" height="905" fill="#ffffff"/>
      <rect x="12" y="12" width="1176" height="881" fill="none" stroke="#0d2346" stroke-width="16"/>

      <rect x="310" y="34" width="580" height="64" rx="8" fill="#0d2346" stroke="#ffd600" stroke-width="5"/>
      <text x="600" y="75" font-family="Arial, Helvetica, sans-serif" font-size="28" font-weight="bold" fill="#ffd600" text-anchor="middle">EXPONENCIAL E LOGARITMO</text>

      <rect x="350" y="112" width="500" height="40" rx="20" fill="#ede7f6" stroke="#6a1b9a" stroke-width="2"/>
      <text x="600" y="139" font-family="Arial, Helvetica, sans-serif" font-size="21" font-weight="bold" fill="#4a148c" text-anchor="middle">
        a<tspan dy="-7" font-size="15">x</tspan><tspan dy="7"> = b ⇔ log</tspan><tspan dy="5" font-size="14">a</tspan><tspan dy="-5">(b) = x   (a &gt; 0, a ≠ 1, b &gt; 0)</tspan>
      </text>

      <rect x="140" y="170" width="340" height="46" rx="6" fill="#1e88e5"/>
      <text x="310" y="200" font-family="Arial, Helvetica, sans-serif" font-size="22" font-weight="bold" fill="#ffffff" text-anchor="middle">
        FUNÇÃO EXPONENCIAL: f(x) = a<tspan dy="-8" font-size="15">x</tspan>
      </text>
      <rect x="720" y="170" width="340" height="46" rx="6" fill="#8e24aa"/>
      <text x="890" y="200" font-family="Arial, Helvetica, sans-serif" font-size="22" font-weight="bold" fill="#ffffff" text-anchor="middle">
        LOGARITMO: f(x) = log<tspan dy="5" font-size="15">a</tspan><tspan dy="-5">(x)</tspan>
      </text>

      <!-- ===== EXPONENCIAL ===== -->
      <rect x="50" y="235" width="520" height="205" rx="8" fill="#f5faff" stroke="#1e88e5" stroke-width="3"/>
      <text x="70" y="265" font-family="Arial, Helvetica, sans-serif" font-size="18" font-weight="bold" fill="#0d2346">1. Condições e Comportamento do Gráfico</text>
      <text x="70" y="295" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">• Condição da base:  a &gt; 0  e  a ≠ 1</text>
      <text x="70" y="322" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">• Domínio: ℝ (x ∈ ℝ)   |   Imagem: ℝ*₊ (y &gt; 0)</text>
      <text x="70" y="349" font-family="Arial, Helvetica, sans-serif" font-size="16" font-weight="bold" fill="#1565c0">• Ponto notável: corta o eixo y sempre em (0, 1)</text>
      <text x="70" y="378" font-family="Arial, Helvetica, sans-serif" font-size="16" font-weight="bold" fill="#2e7d32">
        • CRESCENTE: quando a &gt; 1   (ex: y = 2<tspan dy="-6" font-size="12">x</tspan><tspan dy="6">)</tspan>
      </text>
      <text x="70" y="407" font-family="Arial, Helvetica, sans-serif" font-size="16" font-weight="bold" fill="#c62828">
        • DECRESCENTE (decaimento): quando 0 &lt; a &lt; 1   (ex: y = (0,8)<tspan dy="-6" font-size="12">x</tspan><tspan dy="6">)</tspan>
      </text>
      <text x="70" y="432" class="nota" font-family="Arial, Helvetica, sans-serif">Injetora e sobrejetora em ℝ*₊ → admite inversa: o logaritmo.</text>

      <rect x="50" y="460" width="520" height="215" rx="8" fill="#f5faff" stroke="#1e88e5" stroke-width="3"/>
      <text x="70" y="490" font-family="Arial, Helvetica, sans-serif" font-size="18" font-weight="bold" fill="#0d2346">2. Resolução de Equações Exponenciais</text>

      <text x="70" y="520" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">
        • Método 1 (igualar as bases, a ≠ 1):  a<tspan dy="-6" font-size="12">x</tspan><tspan dy="6"> = a</tspan><tspan dy="-6" font-size="12">y</tspan><tspan dy="6"> ⇒ x = y</tspan>
      </text>
      <text x="90" y="548" font-family="Arial, Helvetica, sans-serif" font-size="16" font-weight="bold" fill="#1565c0">
        Ex: 4<tspan dy="-6" font-size="12">2x−1</tspan><tspan dy="6"> = 8</tspan><tspan dy="-6" font-size="12">x+2</tspan><tspan dy="6"> ⇒ 2</tspan><tspan dy="-6" font-size="12">4x−2</tspan><tspan dy="6"> = 2</tspan><tspan dy="-6" font-size="12">3x+6</tspan><tspan dy="6"> ⇒ 4x−2 = 3x+6 ⇒ x = 8</tspan>
      </text>

      <text x="70" y="580" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">• Método 2 (fatoração / evidência):</text>
      <text x="90" y="606" font-family="Arial, Helvetica, sans-serif" font-size="16" font-weight="bold" fill="#1565c0">
        Ex: 2<tspan dy="-6" font-size="12">x+1</tspan><tspan dy="6"> + 2</tspan><tspan dy="-6" font-size="12">x</tspan><tspan dy="6"> = 24 ⇒ 2</tspan><tspan dy="-6" font-size="12">x</tspan><tspan dy="6">·(2 + 1) = 24 ⇒ 2</tspan><tspan dy="-6" font-size="12">x</tspan><tspan dy="6"> = 8 ⇒ x = 3</tspan>
      </text>

      <text x="70" y="638" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">
        • Método 3 (substituição): chamar a<tspan dy="-6" font-size="12">x</tspan><tspan dy="6"> de "y" (cai em 2º grau)</tspan>
      </text>
      <text x="90" y="660" class="nota" font-family="Arial, Helvetica, sans-serif">
        Depois de achar y, descarta as raízes y ≤ 0 (pois y = a<tspan dy="-5" font-size="10">x</tspan><tspan dy="5"> &gt; 0).</tspan>
      </text>

      <!-- ===== LOGARITMO ===== -->
      <rect x="630" y="235" width="520" height="210" rx="8" fill="#fbf5ff" stroke="#8e24aa" stroke-width="3"/>
      <text x="650" y="265" font-family="Arial, Helvetica, sans-serif" font-size="18" font-weight="bold" fill="#0d2346">1. Condições de Existência e Gráfico</text>
      <text x="650" y="295" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">• Base: a &gt; 0 e a ≠ 1   |   Logaritmando: x &gt; 0</text>
      <text x="650" y="322" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">• Domínio: ℝ*₊ (x &gt; 0)   |   Imagem: ℝ (y ∈ ℝ)</text>
      <text x="650" y="349" font-family="Arial, Helvetica, sans-serif" font-size="16" font-weight="bold" fill="#6a1b9a">• Ponto notável: corta o eixo x sempre em (1, 0)</text>
      <text x="650" y="376" font-family="Arial, Helvetica, sans-serif" font-size="15" fill="#222">• Crescente se a &gt; 1; decrescente se 0 &lt; a &lt; 1 (inversa do exponencial)</text>
      <text x="650" y="403" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">• Consequências diretas:</text>
      <text x="670" y="429" font-family="Arial, Helvetica, sans-serif" font-size="17" font-weight="bold" fill="#4a148c">
        log<tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(1) = 0   |   log</tspan><tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(a) = 1   |   log</tspan><tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(a</tspan><tspan dy="-6" font-size="12">m</tspan><tspan dy="6">) = m   |   a</tspan><tspan dy="-6" font-size="13">logₐ(b)</tspan><tspan dy="6"> = b  [ex: 5</tspan><tspan dy="-6" font-size="13">log₅7</tspan><tspan dy="6"> = 7]</tspan>
      </text>

      <rect x="630" y="465" width="520" height="210" rx="8" fill="#fbf5ff" stroke="#8e24aa" stroke-width="3"/>
      <text x="650" y="495" font-family="Arial, Helvetica, sans-serif" font-size="18" font-weight="bold" fill="#0d2346">2. Propriedades Operatórias (base a, com x &gt; 0 e y &gt; 0)</text>

      <text x="650" y="527" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">• Produto vira SOMA:</text>
      <text x="830" y="527" font-family="Arial, Helvetica, sans-serif" font-size="17" font-weight="bold" fill="#6a1b9a">
        log<tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(x·y) = log</tspan><tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(x) + log</tspan><tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(y)</tspan>
      </text>

      <text x="650" y="561" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">• Divisão vira SUBTRAÇÃO:</text>
      <text x="862" y="561" font-family="Arial, Helvetica, sans-serif" font-size="17" font-weight="bold" fill="#6a1b9a">
        log<tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(x/y) = log</tspan><tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(x) − log</tspan><tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(y)</tspan>
      </text>

      <text x="650" y="595" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">• Potência (regra do tombo):</text>
      <text x="860" y="595" font-family="Arial, Helvetica, sans-serif" font-size="17" font-weight="bold" fill="#6a1b9a">
        log<tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(x</tspan><tspan dy="-6" font-size="12">n</tspan><tspan dy="6">) = n · log</tspan><tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(x)</tspan>
      </text>

      <text x="650" y="629" font-family="Arial, Helvetica, sans-serif" font-size="16" fill="#222">• Mudança de base (c &gt; 0, c ≠ 1):</text>
      <text x="880" y="629" font-family="Arial, Helvetica, sans-serif" font-size="17" font-weight="bold" fill="#d81b60">
        log<tspan dy="4" font-size="12">a</tspan><tspan dy="-4">(b) = log</tspan><tspan dy="4" font-size="12">c</tspan><tspan dy="-4">(b) / log</tspan><tspan dy="4" font-size="12">c</tspan><tspan dy="-4">(a)</tspan>
      </text>

      <text x="650" y="658" class="nota" font-family="Arial, Helvetica, sans-serif">Atenção: log(x + y) ≠ log(x) + log(y) — a soma só vale dentro do logaritmo do produto.</text>

      <!-- ===== RODAPÉ: MODELOS DE APLICAÇÃO ===== -->
      <rect x="50" y="705" width="1100" height="160" rx="10" fill="#fff9c4" stroke="#0d2346" stroke-width="4"/>
      <text x="600" y="736" font-family="Arial, Helvetica, sans-serif" font-size="20" font-weight="bold" fill="#0d2346" text-anchor="middle">🚀 FÓRMULAS DE APLICAÇÃO PRÁTICA (MODELAGEM EXPONENCIAL)</text>

      <text x="80" y="768" font-family="Arial, Helvetica, sans-serif" font-size="16" font-weight="bold" fill="#0d2346">• Juros compostos:</text>
      <text x="80" y="796" font-family="Arial, Helvetica, sans-serif" font-size="18" font-weight="bold" fill="#d81b60">
        M = C · (1 + i)<tspan dy="-7" font-size="13">t</tspan>
      </text>
      <text x="80" y="820" class="nota" font-family="Arial, Helvetica, sans-serif">i em decimal (5% → 0,05) e t na MESMA unidade de i.</text>
      <text x="80" y="840" class="nota" font-family="Arial, Helvetica, sans-serif">M = montante, C = capital inicial.</text>

      <text x="470" y="768" font-family="Arial, Helvetica, sans-serif" font-size="16" font-weight="bold" fill="#0d2346">• Crescimento bacteriano / populacional:</text>
      <text x="470" y="796" font-family="Arial, Helvetica, sans-serif" font-size="18" font-weight="bold" fill="#1565c0">
        N(t) = N<tspan dy="4" font-size="13">0</tspan><tspan dy="-4"> · 2</tspan><tspan dy="-7" font-size="13">t/k</tspan><tspan dy="7">   ou   P(t) = P</tspan><tspan dy="4" font-size="13">0</tspan><tspan dy="-4"> · e</tspan><tspan dy="-7" font-size="13">k·t</tspan>
      </text>
      <text x="470" y="820" class="nota" font-family="Arial, Helvetica, sans-serif">k = tempo de uma geração (dobra); t/k = nº de gerações.</text>
      <text x="470" y="840" class="nota" font-family="Arial, Helvetica, sans-serif">Na 2ª forma, k &gt; 0 cresce e k &lt; 0 decai.</text>

      <text x="890" y="768" font-family="Arial, Helvetica, sans-serif" font-size="16" font-weight="bold" fill="#0d2346">• Meia-vida (decaimento):</text>
      <text x="890" y="796" font-family="Arial, Helvetica, sans-serif" font-size="18" font-weight="bold" fill="#6a1b9a">
        N(t) = N<tspan dy="4" font-size="13">0</tspan><tspan dy="-4"> · (1/2)</tspan><tspan dy="-7" font-size="13">t/p</tspan>
      </text>
      <text x="890" y="820" class="nota" font-family="Arial, Helvetica, sans-serif">p = meia-vida (tempo para cair à metade).</text>
      <text x="890" y="840" class="nota" font-family="Arial, Helvetica, sans-serif">t/p = nº de meias-vidas decorridas.</text>
    </svg>
  </div>

  <script>
    function svgParaDataURL(svg) {
      var clone = svg.cloneNode(true);
      clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
      clone.setAttribute('xmlns:xlink', 'http://www.w3.org/1999/xlink');
      var vb = svg.viewBox.baseVal;
      if (!clone.getAttribute('width')) clone.setAttribute('width', vb.width);
      if (!clone.getAttribute('height')) clone.setAttribute('height', vb.height);
      var str = new XMLSerializer().serializeToString(clone);
      return 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(str)));
    }

    function downloadPNG(svgId, filename, botao) {
      var svg = document.getElementById(svgId);
      if (!svg) { alert('Mapa nao encontrado na pagina.'); return; }
      if (botao) { botao.dataset.rotulo = botao.innerHTML; botao.disabled = true; botao.innerHTML = 'Gerando imagem...'; }

      var vb = svg.viewBox.baseVal;
      var largura = vb.width || 1200;
      var altura  = vb.height || 960;
      var escala  = 2;

      function restaurar() {
        if (botao) { botao.disabled = false; botao.innerHTML = botao.dataset.rotulo; }
      }
      function falhar() {
        alert('Nao foi possivel gerar o PNG neste navegador.\nAlternativa: use Imprimir > Salvar como PDF.');
        restaurar();
      }

      var img = new Image();
      img.onload = function () {
        try {
          var canvas = document.createElement('canvas');
          canvas.width  = Math.round(largura * escala);
          canvas.height = Math.round(altura * escala);
          var ctx = canvas.getContext('2d');
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.scale(escala, escala);
          ctx.drawImage(img, 0, 0, largura, altura);
          canvas.toBlob(function (blob) {
            if (!blob) { falhar(); return; }
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url; a.download = filename;
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            setTimeout(function () { URL.revokeObjectURL(url); }, 3000);
            restaurar();
          }, 'image/png');
        } catch (e) { console.error(e); falhar(); }
      };
      img.onerror = function () { console.error('Falha ao carregar o SVG.'); falhar(); };
      img.src = svgParaDataURL(svg);
    }
  </script>
